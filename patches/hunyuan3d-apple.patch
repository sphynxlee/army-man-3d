+def _remap_dinov2_keys(state):
+    """Map the 2025 DINOv2 checkpoint names onto transformers 5 modules."""
+    remapped = {}
+    for key, value in state.items():
+        if ".mlp.weights_in." in key:
+            half = value.shape[0] // 2
+            prefix, suffix = key.split(".mlp.weights_in.")
+            remapped[f"{prefix}.mlp.gate_proj.{suffix}"] = value[:half].contiguous()
+            remapped[f"{prefix}.mlp.up_proj.{suffix}"] = value[half:].contiguous()
+            continue
+        key = key.replace(".mlp.weights_out.", ".mlp.down_proj.")
+        key = key.replace(".attention.attention.query.", ".attention.q_proj.")
+        key = key.replace(".attention.attention.key.", ".attention.k_proj.")
+        key = key.replace(".attention.attention.value.", ".attention.v_proj.")
+        key = key.replace(".attention.output.dense.", ".attention.o_proj.")
+        remapped[key] = value
+    return remapped
